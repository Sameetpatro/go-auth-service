# =============================================================================
# Local development / Render env template
# Copy this file to .env and fill in your Render Internal Database URL.
# On Render hosting: set these in Dashboard → Service → Environment (not .env).
# =============================================================================

# Server (Render sets PORT automatically — leave unset when deployed on Render)
SERVER_PORT=8080
ENVIRONMENT=development
SERVER_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database — paste your Neon POOLED connection string here (one line is enough)
# Get it from console.neon.tech → your project → Connection Details →
# check "Pooled connection". Example:
# DATABASE_URL=postgresql://user:xxxxx@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/event_entry?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=

# Optional: only if you prefer individual vars instead of DATABASE_URL
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=event_entry
# DB_SSLMODE=require

# Auto-run migrations on startup (recommended for Render first deploy)
AUTO_MIGRATE=true

# JWT — Render can auto-generate these; set strong secrets for production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=720h

# Event (printed below each guest QR code)
EVENT_NAME=FELICITATIONS & VEER GOKULA MANCHAN
EVENT_DATE=19 July 2026 | 2:00 PM
EVENT_LOCATION=Bharat Mandapam, New Delhi

# Storage
# CLOUDINARY_URL enables permanent QR image storage + CDN delivery (recommended
# for production). Get it from console.cloudinary.com → Dashboard → API Keys.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# When unset, QR images are written to local disk (fine for local dev only —
# on Render the disk is ephemeral and images vanish on restart).
CLOUDINARY_URL=
QR_IMAGE_PATH=./storage/qr
QR_IMAGE_URL=http://localhost:8080/storage/qr

# Rate Limiting
RATE_LIMIT_RPM=100

# CORS
CORS_ALLOWED_ORIGINS=*
